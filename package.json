{
  "name": "arunika-private-assets",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && wrangler pages dev dist --compatibility-date=2026-11-01 --d1=DB",
    "deploy": "npm run build && wrangler pages deploy dist",
    "test": "node --test tests/*.test.js",
    "password": "node scripts/password.mjs",
    "build": "node scripts/build.mjs",
    "deploy:worker": "wrangler deploy -c wrangler.worker.jsonc"
  },
  "devDependencies": {
    "wrangler": "4.162.0",
    "esbuild": "0.27.4"
  }
}
