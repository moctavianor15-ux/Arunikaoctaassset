{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arunika-aset-pribadi",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "arunika-private",
      "database_id": "GANTI_DENGAN_ID_D1",
      "migrations_dir": "migrations"
    }
  ],
  "limits": {
    "cpu_ms": 1000
  },
  "triggers": {
    "crons": [
      "17 3 * * *"
    ]
  },
  "observability": {
    "enabled": true
  },
  "ai": {
    "binding": "AI"
  }
}
